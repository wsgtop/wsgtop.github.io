[{"data":1,"prerenderedAt":509},["ShallowReactive",2],{"article-ai-prompt-engineering":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"date":10,"category":11,"tags":12,"body":17,"_type":503,"_id":504,"_source":505,"_file":506,"_stem":507,"_extension":508},"\u002Farticles\u002Fai-prompt-engineering","articles",false,"","从零开始学提示工程：让 AI 成为你的生产力搭档","系统介绍大语言模型提示工程的核心原则与常用技巧，从入门到进阶，教你写出高效、准确、可复用的高质量 Prompt。","2026-07-20","人工智能",[13,14,15,16],"提示工程","AI","GPT","效率",{"type":18,"children":19,"toc":482},"root",[20,28,42,49,61,66,204,210,217,225,235,243,251,257,269,277,283,295,303,309,315,320,328,334,339,347,353,358,366,372,377,385,391,397,405,411,419,425,470],{"type":21,"tag":22,"props":23,"children":25},"element","h1",{"id":24},"从零开始学提示工程",[26],{"type":27,"value":24},"text",{"type":21,"tag":29,"props":30,"children":31},"p",{},[32,34,40],{"type":27,"value":33},"随着 GPT、Claude 等大语言模型（LLM）走入日常开发，",{"type":21,"tag":35,"props":36,"children":37},"strong",{},[38],{"type":27,"value":39},"能否写出好的提示词（Prompt）",{"type":27,"value":41}," 已经成为新的核心技能。好的提示词能让 AI 交付 90 分甚至满分的答案，差的提示词只会得到一堆看似正确实则无用的废话。",{"type":21,"tag":43,"props":44,"children":46},"h2",{"id":45},"一什么是提示工程",[47],{"type":27,"value":48},"一、什么是提示工程？",{"type":21,"tag":29,"props":50,"children":51},{},[52,54,59],{"type":27,"value":53},"提示工程不是玄学，而是 ",{"type":21,"tag":35,"props":55,"children":56},{},[57],{"type":27,"value":58},"用清晰、精确、结构化的自然语言，向 LLM 描述任务",{"type":27,"value":60}," 的过程。LLM 的本质是\"预测下一个最可能的词\"，你给它的上下文越充分、约束越明确，它输出的结果就越贴近你的预期。",{"type":21,"tag":29,"props":62,"children":63},{},[64],{"type":27,"value":65},"一个好的提示词通常包含五要素：",{"type":21,"tag":67,"props":68,"children":69},"table",{},[70,94],{"type":21,"tag":71,"props":72,"children":73},"thead",{},[74],{"type":21,"tag":75,"props":76,"children":77},"tr",{},[78,84,89],{"type":21,"tag":79,"props":80,"children":81},"th",{},[82],{"type":27,"value":83},"要素",{"type":21,"tag":79,"props":85,"children":86},{},[87],{"type":27,"value":88},"作用",{"type":21,"tag":79,"props":90,"children":91},{},[92],{"type":27,"value":93},"示例",{"type":21,"tag":95,"props":96,"children":97},"tbody",{},[98,120,141,162,183],{"type":21,"tag":75,"props":99,"children":100},{},[101,110,115],{"type":21,"tag":102,"props":103,"children":104},"td",{},[105],{"type":21,"tag":35,"props":106,"children":107},{},[108],{"type":27,"value":109},"角色",{"type":21,"tag":102,"props":111,"children":112},{},[113],{"type":27,"value":114},"告诉 AI 它是谁，让它代入专家视角",{"type":21,"tag":102,"props":116,"children":117},{},[118],{"type":27,"value":119},"\"你是一名有 10 年经验的前端架构师\"",{"type":21,"tag":75,"props":121,"children":122},{},[123,131,136],{"type":21,"tag":102,"props":124,"children":125},{},[126],{"type":21,"tag":35,"props":127,"children":128},{},[129],{"type":27,"value":130},"任务",{"type":21,"tag":102,"props":132,"children":133},{},[134],{"type":27,"value":135},"明确告诉它要做什么，不要模糊",{"type":21,"tag":102,"props":137,"children":138},{},[139],{"type":27,"value":140},"\"请重构这段 React 代码\" 而不是 \"帮我看看这个\"",{"type":21,"tag":75,"props":142,"children":143},{},[144,152,157],{"type":21,"tag":102,"props":145,"children":146},{},[147],{"type":21,"tag":35,"props":148,"children":149},{},[150],{"type":27,"value":151},"上下文",{"type":21,"tag":102,"props":153,"children":154},{},[155],{"type":27,"value":156},"提供执行任务所需的背景信息",{"type":21,"tag":102,"props":158,"children":159},{},[160],{"type":27,"value":161},"代码片段、项目背景、用户需求",{"type":21,"tag":75,"props":163,"children":164},{},[165,173,178],{"type":21,"tag":102,"props":166,"children":167},{},[168],{"type":21,"tag":35,"props":169,"children":170},{},[171],{"type":27,"value":172},"约束",{"type":21,"tag":102,"props":174,"children":175},{},[176],{"type":27,"value":177},"明确不能做什么、要遵守什么规则",{"type":21,"tag":102,"props":179,"children":180},{},[181],{"type":27,"value":182},"\"不要引入新依赖\"、\"输出必须是 TypeScript\"",{"type":21,"tag":75,"props":184,"children":185},{},[186,194,199],{"type":21,"tag":102,"props":187,"children":188},{},[189],{"type":21,"tag":35,"props":190,"children":191},{},[192],{"type":27,"value":193},"输出格式",{"type":21,"tag":102,"props":195,"children":196},{},[197],{"type":27,"value":198},"指定回答的结构与形式",{"type":21,"tag":102,"props":200,"children":201},{},[202],{"type":27,"value":203},"\"用表格输出\"、\"JSON 格式、字段如下\"",{"type":21,"tag":43,"props":205,"children":207},{"id":206},"二入门三原则",[208],{"type":27,"value":209},"二、入门三原则",{"type":21,"tag":211,"props":212,"children":214},"h3",{"id":213},"原则-1具体不要模糊",[215],{"type":27,"value":216},"原则 1：具体，不要模糊",{"type":21,"tag":29,"props":218,"children":219},{},[220],{"type":21,"tag":35,"props":221,"children":222},{},[223],{"type":27,"value":224},"❌ 糟糕的提示：",{"type":21,"tag":226,"props":227,"children":229},"pre",{"code":228},"帮我写个网站\n",[230],{"type":21,"tag":231,"props":232,"children":233},"code",{"__ignoreMap":7},[234],{"type":27,"value":228},{"type":21,"tag":29,"props":236,"children":237},{},[238],{"type":21,"tag":35,"props":239,"children":240},{},[241],{"type":27,"value":242},"✅ 好的提示：",{"type":21,"tag":226,"props":244,"children":246},{"code":245},"请用 Next.js 14 + Tailwind CSS 写一个博客首页，要求：\n1. 顶部导航栏包含 logo、菜单、搜索框、主题切换按钮\n2. 首屏 Hero 区展示博客标题、一句 Slogan、CTA 按钮\n3. 下方展示最新 6 篇文章卡片，包含封面、标题、摘要、日期\n4. 使用响应式设计，移动端适配良好\n5. 代码分组件组织，不要都写在一个文件里\n",[247],{"type":21,"tag":231,"props":248,"children":249},{"__ignoreMap":7},[250],{"type":27,"value":245},{"type":21,"tag":211,"props":252,"children":254},{"id":253},"原则-2给示例few-shot-prompting",[255],{"type":27,"value":256},"原则 2：给示例（Few-Shot Prompting）",{"type":21,"tag":29,"props":258,"children":259},{},[260,262,267],{"type":27,"value":261},"当你需要特定风格或格式时，",{"type":21,"tag":35,"props":263,"children":264},{},[265],{"type":27,"value":266},"给 2-3 个示例",{"type":27,"value":268}," 比描述 100 个字更有效：",{"type":21,"tag":226,"props":270,"children":272},{"code":271},"请将以下产品描述重写成更有说服力的营销文案，风格参考示例：\n\n示例 1：\n原文：这双鞋透气。\n重写：夏日炎炎，双脚也能自由呼吸 —— 每一步都像踩在云上 ☁️\n\n示例 2：\n原文：这款充电宝容量大。\n重写：20000mAh 超大能量，陪你从日出看到星河，告别电量焦虑 ⚡\n\n现在请重写：\n原文：这个保温杯保温效果很好。\n",[273],{"type":21,"tag":231,"props":274,"children":275},{"__ignoreMap":7},[276],{"type":27,"value":271},{"type":21,"tag":211,"props":278,"children":280},{"id":279},"原则-3分步思考chain-of-thought",[281],{"type":27,"value":282},"原则 3：分步思考（Chain of Thought）",{"type":21,"tag":29,"props":284,"children":285},{},[286,288,293],{"type":27,"value":287},"对于数学题、逻辑推理、代码分析等复杂问题，加上一句 ",{"type":21,"tag":35,"props":289,"children":290},{},[291],{"type":27,"value":292},"\"请一步步思考并展示你的推理过程\"",{"type":27,"value":294},"，准确率会大幅提升：",{"type":21,"tag":226,"props":296,"children":298},{"code":297},"用户在一个商店买了 3 个苹果和 2 个梨，苹果每个 5 元，梨每个 4 元。\n他又买了 1 袋 18 元的薯片，结账时使用了一张满 50 减 10 的优惠券。\n请问用户最终实际付了多少钱？\n\n请一步步思考，先列出每个步骤，再给出最终答案。\n",[299],{"type":21,"tag":231,"props":300,"children":301},{"__ignoreMap":7},[302],{"type":27,"value":297},{"type":21,"tag":43,"props":304,"children":306},{"id":305},"三进阶技巧",[307],{"type":27,"value":308},"三、进阶技巧",{"type":21,"tag":211,"props":310,"children":312},{"id":311},"_1-结构化输出",[313],{"type":27,"value":314},"1. 结构化输出",{"type":21,"tag":29,"props":316,"children":317},{},[318],{"type":27,"value":319},"不要让 AI 自由发挥格式，明确指定输出结构：",{"type":21,"tag":226,"props":321,"children":323},{"code":322},"请分析以下代码的潜在问题，输出 JSON 数组，每个元素包含：\n- severity: \"error\" | \"warning\" | \"info\"\n- line: 行号\n- issue: 问题描述\n- suggestion: 修改建议\n\n代码如下：\n\n```js\nfunction foo(arr) {\n  for (var i = 0; i \u003C arr.length; i++) {\n    setTimeout(() => console.log(arr[i]), 100);\n  }\n}\n",[324],{"type":21,"tag":231,"props":325,"children":326},{"__ignoreMap":7},[327],{"type":27,"value":322},{"type":21,"tag":211,"props":329,"children":331},{"id":330},"_2-约束幻觉",[332],{"type":27,"value":333},"2. 约束幻觉",{"type":21,"tag":29,"props":335,"children":336},{},[337],{"type":27,"value":338},"LLM 会\"编\"答案，尤其是在它不知道的时候。加上这句约束：",{"type":21,"tag":226,"props":340,"children":342},{"code":341},"如果你不确定答案，请直接说\"我不知道\"，不要编造内容。\n如果有引用，请注明来源出处。\n",[343],{"type":21,"tag":231,"props":344,"children":345},{"__ignoreMap":7},[346],{"type":27,"value":341},{"type":21,"tag":211,"props":348,"children":350},{"id":349},"_3-角色扮演-多视角复核",[351],{"type":27,"value":352},"3. 角色扮演 + 多视角复核",{"type":21,"tag":29,"props":354,"children":355},{},[356],{"type":27,"value":357},"让 AI 同时扮演多个角色，用不同视角审视同一个问题：",{"type":21,"tag":226,"props":359,"children":361},{"code":360},"请扮演三位角色评审我的技术方案：\n1. 资深架构师：从可扩展性、性能、可维护性角度挑刺\n2. 安全工程师：从安全漏洞、数据隐私、权限角度检查\n3. 产品经理：从用户体验、开发成本、上线时间角度评估\n\n方案：我打算用纯前端 localStorage 存用户的登录凭证和订单数据。\n\n请三位分别给出意见，最后给出一个综合建议。\n",[362],{"type":21,"tag":231,"props":363,"children":364},{"__ignoreMap":7},[365],{"type":27,"value":360},{"type":21,"tag":211,"props":367,"children":369},{"id":368},"_4-迭代优化self-correction",[370],{"type":27,"value":371},"4. 迭代优化（Self-Correction）",{"type":21,"tag":29,"props":373,"children":374},{},[375],{"type":27,"value":376},"一次输出不满意？让它自己改自己：",{"type":21,"tag":226,"props":378,"children":380},{"code":379},"请阅读你刚才生成的代码，然后：\n1. 找出其中可能存在的 Bug 和性能问题\n2. 用更简洁、更符合现代 JavaScript 习惯的方式重写\n3. 加上必要的注释和 JSDoc 类型说明\n",[381],{"type":21,"tag":231,"props":382,"children":383},{"__ignoreMap":7},[384],{"type":27,"value":379},{"type":21,"tag":43,"props":386,"children":388},{"id":387},"四模板速查",[389],{"type":27,"value":390},"四、模板速查",{"type":21,"tag":211,"props":392,"children":394},{"id":393},"代码重构模板",[395],{"type":27,"value":396},"📝 代码重构模板",{"type":21,"tag":226,"props":398,"children":400},{"code":399},"角色：你是一名资深 {编程语言} 工程师，推崇简洁、可测试、高性能的代码风格。\n\n任务：请重构以下代码。\n\n上下文：这段代码在 {项目\u002F模块} 中使用，作用是 {简要说明}。\n\n约束：\n- 必须保持原有功能不变，所有外部接口签名兼容\n- 不要引入项目中没有的第三方依赖\n- 要考虑异常处理和边界情况\n- 性能要至少与原版持平或更好\n\n输出要求：\n1. 先列出原始代码的主要问题（3-5 条）\n2. 给出重构后的完整代码\n3. 解释做了哪些改动以及为什么\n\n原代码：\n{粘在这里}\n",[401],{"type":21,"tag":231,"props":402,"children":403},{"__ignoreMap":7},[404],{"type":27,"value":399},{"type":21,"tag":211,"props":406,"children":408},{"id":407},"长文总结模板",[409],{"type":27,"value":410},"📖 长文总结模板",{"type":21,"tag":226,"props":412,"children":414},{"code":413},"请阅读以下文章，输出一份总结报告，包含：\n1. 核心论点（一句话）\n2. 3-5 个关键要点，每个要点配一句话解释\n3. 2-3 个最有启发性的观点或金句\n4. 3 个可以立即落地的行动建议\n5. 一个值得继续深入思考的问题\n\n要求用中文，通俗易懂，避免原文字面翻译和堆砌术语。\n\n文章内容：\n{粘在这里}\n",[415],{"type":21,"tag":231,"props":416,"children":417},{"__ignoreMap":7},[418],{"type":27,"value":413},{"type":21,"tag":43,"props":420,"children":422},{"id":421},"五避坑指南",[423],{"type":27,"value":424},"五、避坑指南",{"type":21,"tag":426,"props":427,"children":428},"ol",{},[429,440,450,460],{"type":21,"tag":430,"props":431,"children":432},"li",{},[433,438],{"type":21,"tag":35,"props":434,"children":435},{},[436],{"type":27,"value":437},"不要一次问太多问题",{"type":27,"value":439},"：一个 prompt 一个任务，拆分成多轮对话效果更好。",{"type":21,"tag":430,"props":441,"children":442},{},[443,448],{"type":21,"tag":35,"props":444,"children":445},{},[446],{"type":27,"value":447},"不要把重要信息藏在长文本末尾",{"type":27,"value":449},"：关键约束放在开头或最后单独强调。",{"type":21,"tag":430,"props":451,"children":452},{},[453,458],{"type":21,"tag":35,"props":454,"children":455},{},[456],{"type":27,"value":457},"不要迷信一次成功",{"type":27,"value":459},"：优秀的提示词是迭代出来的，先写一版，看输出再调整。",{"type":21,"tag":430,"props":461,"children":462},{},[463,468],{"type":21,"tag":35,"props":464,"children":465},{},[466],{"type":27,"value":467},"不要忽略系统提示词（System Prompt）",{"type":27,"value":469},"：System 级别的角色设定比用户消息权重更高。",{"type":21,"tag":29,"props":471,"children":472},{},[473,475,480],{"type":27,"value":474},"提示工程的本质是 ",{"type":21,"tag":35,"props":476,"children":477},{},[478],{"type":27,"value":479},"\"把脑子里的隐性知识显性化\"",{"type":27,"value":481}," —— 你越清楚自己想要什么，越能清晰地描述出来，AI 就越能成为你的得力搭档。从今天开始，把每一次和 AI 的对话当成练习，你会发现这个技能的回报超乎想象 ✨",{"title":7,"searchDepth":483,"depth":483,"links":484},2,[485,486,492,498,502],{"id":45,"depth":483,"text":48},{"id":206,"depth":483,"text":209,"children":487},[488,490,491],{"id":213,"depth":489,"text":216},3,{"id":253,"depth":489,"text":256},{"id":279,"depth":489,"text":282},{"id":305,"depth":483,"text":308,"children":493},[494,495,496,497],{"id":311,"depth":489,"text":314},{"id":330,"depth":489,"text":333},{"id":349,"depth":489,"text":352},{"id":368,"depth":489,"text":371},{"id":387,"depth":483,"text":390,"children":499},[500,501],{"id":393,"depth":489,"text":396},{"id":407,"depth":489,"text":410},{"id":421,"depth":483,"text":424},"markdown","content:articles:ai-prompt-engineering.md","content","articles\u002Fai-prompt-engineering.md","articles\u002Fai-prompt-engineering","md",1785598913126]