":401},"onUpdated",{"type":19,"tag":306,"props":403,"children":404},{},[405,410],{"type":19,"tag":328,"props":406,"children":407},{},[408],{"type":25,"value":409},"beforeUnmount",{"type":19,"tag":328,"props":411,"children":412},{},[413],{"type":25,"value":414},"onBeforeUnmount",{"type":19,"tag":306,"props":416,"children":417},{},[418,423],{"type":19,"tag":328,"props":419,"children":420},{},[421],{"type":25,"value":422},"unmounted",{"type":19,"tag":328,"props":424,"children":425},{},[426],{"type":25,"value":427},"onUnmounted",{"type":19,"tag":34,"props":429,"children":431},{"id":430},"实战封装一个-uselocalstorage-composable",[432],{"type":25,"value":433},"实战：封装一个 useLocalStorage composable",{"type":19,"tag":28,"props":435,"children":436},{},[437,439,444],{"type":25,"value":438},"组合式 API 最强的能力之一是 ",{"type":19,"tag":77,"props":440,"children":441},{},[442],{"type":25,"value":443},"逻辑复用",{"type":25,"value":445},"。让我们写一个持久化存储到 localStorage 的 composable：",{"type":19,"tag":85,"props":447,"children":450},{"className":448,"code":449,"language":90,"meta":7},[88],"\u002F\u002F composables\u002FuseLocalStorage.ts\nexport function useLocalStorage\u003CT>(key: string, initialValue: T) {\n  \u002F\u002F 初始化：从 localStorage 读取\n  const stored = localStorage.getItem(key)\n  const data = ref\u003CT>(stored ? JSON.parse(stored) : initialValue) as Ref\u003CT>\n\n  \u002F\u002F 数据变化时自动保存\n  watch(\n    data,\n    (newVal) => {\n      localStorage.setItem(key, JSON.stringify(newVal))\n    },\n    { deep: true } \u002F\u002F 深度监听对象\u002F数组\n  )\n\n  \u002F\u002F 提供手动清理方法\n  const clear = () => {\n    localStorage.removeItem(key)\n    data.value = initialValue\n  }\n\n  return { data, clear }\n}\n",[451],{"type":19,"tag":46,"props":452,"children":453},{"__ignoreMap":7},[454],{"type":25,"value":449},{"type":19,"tag":28,"props":456,"children":457},{},[458],{"type":25,"value":459},"在任意组件中使用：",{"type":19,"tag":85,"props":461,"children":466},{"className":462,"code":464,"language":465,"meta":7},[463],"l