anguage":90,"meta":7},[88],"const count = ref(0)\nconsole.log(count.value) \u002F\u002F 0\ncount.value++\n",[152],{"type":19,"tag":46,"props":153,"children":154},{"__ignoreMap":7},[155],{"type":25,"value":150},{"type":19,"tag":28,"props":157,"children":158},{},[159,165,167,172,174,179],{"type":19,"tag":46,"props":160,"children":162},{"className":161},[],[163],{"type":25,"value":164},"reactive",{"type":25,"value":166}," 用于创建对象类型的响应式代理，",{"type":19,"tag":77,"props":168,"children":169},{},[170],{"type":25,"value":171},"不需要",{"type":25,"value":173}," ",{"type":19,"tag":46,"props":175,"children":177},{"className":176},[],[178],{"type":25,"value":145},{"type":25,"value":107},{"type":19,"tag":85,"props":181,"children":184},{"className":182,"code":183,"language":90,"meta":7},[88],"const state = reactive({ name: 'Alice', age: 18 })\nconsole.log(state.name) \u002F\u002F Alice\nstate.age++\n",[185],{"type":19,"tag":46,"props":186,"children":187},{"__ignoreMap":7},[188],{"type":25,"value":183},{"type":19,"tag":190,"props":191,"children":192},"blockquote",{},[193],{"type":19,"tag":28,"props":194,"children":195},{},[196,198,203,205,210,212,217,219,224],{"type":25,"value":197},"💡 ",{"type":19,"tag":77,"props":199,"children":200},{},[201],{"type":25,"value":202},"何时用哪个？",{"type":25,"value":204}," 基本类型（数字、字符串、布尔）用 ",{"type":19,"tag":46,"props":206,"children":208},{"className":207},[],[209],{"type":25,"value":137},{"type":25,"value":211},"，复杂对象用 ",{"type":19,"tag":46,"props":213,"children":215},{"className":214},[],[216],{"type":25,"value":164},{"type":25,"value":218},"。不确定时用 ",{"type":19,"tag":46,"props":220,"children":222},{"className":221},[],[223],{"type":25,"value":137},{"type":25,"value":225}," 更安全。",{"type":19,"tag":123,"props":227,"children":229},{"id":228},"_2-computed-计算属性",[230],{"type":25,"value":231},"2. computed 计算属性",{"type":19,"tag":28,"props":233,"children":234},{},[235],{"type":25,"value":236},"计算属性会自动追踪其依赖的响应式状态，并缓存结果：",{"type":19,"tag":85,"props":238,"children":241},{"className":239,"code":240,"language":90,"meta":7},[88],"const firstName = ref('张')\nconst lastName = ref('三')\n\n\u002F\u002F 只读 computed\nconst fullName = computed(() => `${firstName.value}${lastName.value}`)\n\n\u002F\u002F 可写 computed\nconst writableFullName = computed({\n  get: () => `${firstName.value}${lastName.value}`,\n  set: (val) => {\n    [firstName.value, lastName.value] = [val[0], val.slice(1)]\n  }\n})\n",[242],{"type":19,"tag":46,"props":243,"children":244},{"__ignoreMap":7},[245],{"type":25,"value":240},{"type":19,"tag":123,"props":247,"children":249},{"id":248},"_3-watch-与-watcheffect",[250],{"type":25,"value":251},"3. watch 与 watchEffect",{"type":19,"tag":28,"props":253,"children":254},{},[255,260],{"type":19,"tag":46,"props":256,"children":258},{"className":257},[],[259],{"type":25,"value":73},{"type":25,"value":261}," 需要显式指定监听的源：",{"type":19,"tag":85,"props":263,"children":266},{"className":264,"code":265,"language":90,"meta":7},[88],"\u002F\u002F 监听 ref\nwatch(count, (newVal, oldVal) => console.log(`${oldVal} → ${newVal}`))\n\n\u002F\u002F 监听 reactive 的某个属性\nwatch(() => state.age, (age) => console.log('age:', age))\n\n\u002F\u002F 多源监听\nwatch([count, firstName], ([newC, newF]) => { \u002F* ... *\u002F })\n",[267],{"type":19,"tag":46,"props":268,"children":269},{"__ignoreMap":7},[270],{"type":25,"value":265},{"type":19,"tag":28,"props":272,"children":273},{},[274,280],{"type":19,"tag":46,"props":275,"children":277},{"className":276},[],[278],{"type":25,"value":279},"watchEffect",{"type":25,"value":281}," 会自动追踪执行过程中访问到的响应式依赖：",{"type":19,"tag":85,"props":283,"children":286},{"className":284,"code":285,"language":90,"meta":7},[88],"watchEffect(() => {\n  console.log(`count=${count.value}, name=${firstName.value}`)\n})\n\u002F\u002F 任何依赖变化时都会重新执行\n",[287],{"type":19,"tag":46,"props":288,"children":289},{"__ignoreMap":7},[290],{"type":25,"value":285},{"type":19,"tag":123,"props":292,"children":294},{"id":293},"_4-生命周期钩子",[295],{"type":25,"value"