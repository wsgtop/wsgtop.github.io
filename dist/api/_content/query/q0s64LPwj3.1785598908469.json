 监听 reactive 的某个属性\nwatch(() => state.age, (age) => console.log('age:', age))\n\n// 多源监听\nwatch([count, firstName], ([newC, newF]) => { /* ... */ })\n"}]}]},{"type":"element","tag":"p","props":{},"children":[{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"watchEffect"}]},{"type":"text","value":" 会自动追踪执行过程中访问到的响应式依赖："}]},{"type":"element","tag":"pre","props":{"className":["language-typescript"],"code":"watchEffect(() => {\n  console.log(`count=${count.value}, name=${firstName.value}`)\n})\n// 任何依赖变化时都会重新执行\n","language":"typescript","meta":""},"children":[{"type":"element","tag":"code","props":{"__ignoreMap":""},"children":[{"type":"text","value":"watchEffect(() => {\n  console.log(`count=${count.value}, name=${firstName.value}`)\n})\n// 任何依赖变化时都会重新执行\n"}]}]},{"type":"element","tag":"h3","props":{"id":"_4-生命周期钩子"},"children":[{"type":"text","value":"4. 生命周期钩子"}]},{"type":"element","tag":"table","props":{},"children":[{"type":"element","tag":"thead","props":{},"children":[{"type":"element","tag":"tr","props":{},"children":[{"type":"element","tag":"th","props":{},"children":[{"type":"text","value":"选项式 API"}]},{"type":"element","tag":"th","props":{},"children":[{"type":"text","value":"组合式 API (onXxx)"}]}]}]},{"type":"element","tag":"tbody","props":{},"children":[{"type":"element","tag":"tr","props":{},"children":[{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"beforeCreate"}]},{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"直接写在 setup 里"}]}]},{"type":"element","tag":"tr","props":{},"children":[{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"created"}]},{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"直接写在 setup 里"}]}]},{"type":"element","tag":"tr","props":{},"children":[{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"beforeMount"}]},{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"onBeforeMount"}]}]},{"type":"element","tag":"tr","props":{},"children":[{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"mounted"}]},{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"onMounted"}]}]},{"type":"element","tag":"tr","props":{},"children":[{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"beforeUpdate"}]},{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"onBeforeUpdate"}]}]},{"type":"element","tag":"tr","props":{},"children":[{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"updated"}]},{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"onUpdated"}]}]},{"type":"element","tag":"tr","props":{},"children":[{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"beforeUnmount"}]},{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"onBeforeUnmount"}]}]},{"type":"element","tag":"tr","props":{},"children":[{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"unmounted"}]},{"type":"element","tag":"td","props":{},"children":[{"type":"text","value":"onUnmounted"}]}]}]}]},{"type":"element","tag":"h2","props":{"id":"实战封装一个-uselocalstorage-composable"},"children":[{"type":"text","value":"实战：封装一个 useLocalStorage composable"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"组合式 API 最强的能力之一是 "},{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"逻辑复用"}]},{"type":"text","value":"。让我们写一个持久化存储到 localStorage 的 composable："}]},{"type":"element","tag":"pre","props":{"className":["language-typescript"],"code":"// composables/useLocalStorage.ts\nexport function useLocalStorage<T>(key: string, initialValue: T) {\n  // 初始化：从 localStorage 读取\n  const stored = localStorage.getItem(key)\n  const data = ref<T>(stored ? JSON.parse(stored) : initialValue) as Ref<T>\n\n  // 数据变化时自动保存\n  watch(\n    data,\n    (newVal) => {\n      localStorage.setItem(key, JSON.stringify(newVal))\n    },\n    { deep: true } // 深度监听对象/数组\n  )\n\n  // 提供手动清理方法\n  const clear = () => {\n    localStorage.removeItem(key)\n    data.value = initialValue\n  }\n\n  return { data, clear }\n}\n","language":"typescript","meta":""},"children":[{"type":"element","tag":"code","props":{"__ignoreMap":""},"children":[{"type":"text","value":"// composables/useLocalStorage.ts\nexport function useLocalStorage<T>(key: string, initialValue: T) {\n  // 初始化：从 localStorage 读取\n  const stored = localStorage.getItem(key)\n  const data = ref<T>(stored ? JSON.parse(stored) : initialValue) as Ref<T>\n\n  // 数据变化时自动保存\n  watch(\n    data,\n    (newVal) => {\n      localStorage.setItem(key, JSON.stringify(newVal))\n    },\n    { deep: true } // 深度监听对象/数组\n  )\n\n  // 提供手动清理方法\n  const clear = () => {\n    localStorage.removeItem(key)\n    data.value = initialValue\n  }\n\n  return { data, clear }\n}\n"}]}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"在任意组件中使用："}]},{"type":"element","tag":"pre","props":{"className":["language-vue"],"code":"<script setup lang=\"ts\">\nconst { data: settings, clear: resetSettings } = useLocalStorage('user-settings', {\n  theme: 'light',\n  language: 'zh-CN',\n  fontSize: 14\n})\n</script>\n\n<template>\n  <p>当前主题：{{ settings.theme }}</p>\n  <button @click=\"settings.theme = 'dark'\">切换深色</button>\n  <button @click=\"resetSettings\">重置</button>\n</template>\n","language":"vue","meta":""},"children":[{"type":"element","tag":"code","props":{"__ignoreMap":""},"children":[{"type":"text","value":"<script setup lang=\"ts\">\nconst { data: settings, clear: resetSettings } = useLocalStorage('user-settings', {\n  theme: 'light',\n  language: 'zh-CN',\n  fontSize: 14\n})\n</script>\n\n<template>\n  <p>当前主题：{{ settings.theme }}</p>\n  <button @click=\"settings.theme = 'dark'\">切换深色</button>\n  <button @click=\"resetSettings\">重置</button>\n</template>\n"}]}]