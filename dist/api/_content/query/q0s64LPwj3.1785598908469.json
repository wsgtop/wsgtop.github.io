{"_path":"/articles/vue3-composition-api-practice","_dir":"articles","_draft":false,"_partial":false,"_locale":"","title":"Vue 3 组合式 API 实战：从选项式到 Composition 的迁移指南","description":"详细介绍 Vue 3 组合式 API 的核心理念与实战用法，对比选项式 API 的差异，并提供渐进式迁移的最佳实践。","date":"2026-07-28","category":"Vue 3","tags":["Vue 3","Composition API","前端"],"body":{"type":"root","children":[{"type":"element","tag":"h1","props":{"id":"vue-3-组合式-api-实战"},"children":[{"type":"text","value":"Vue 3 组合式 API 实战"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Vue 3 引入的组合式 API（Composition API）彻底改变了我们组织组件逻辑的方式。相比选项式 API，组合式 API 提供了更灵活的代码复用、更清晰的类型推断，以及更好的大型组件可维护性。"}]},{"type":"element","tag":"h2","props":{"id":"为什么需要组合式-api"},"children":[{"type":"text","value":"为什么需要组合式 API？"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"在选项式 API 中，我们将逻辑分散在 "},{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"data"}]},{"type":"text","value":"、"},{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"computed"}]},{"type":"text","value":"、"},{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"methods"}]},{"type":"text","value":"、"},{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"watch"}]},{"type":"text","value":" 等不同选项中。当组件变得复杂时，"},{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"一个功能的代码会散落在组件的各个角落"}]},{"type":"text","value":"，阅读和维护都非常困难。"}]},{"type":"element","tag":"pre","props":{"className":["language-typescript"],"code":"// 选项式：一个功能的代码被分散\nexport default {\n  data() { return { count: 0, user: null } },\n  computed: { doubleCount() { /* ... */ } },\n  methods: { increment() { /* ... */ }, fetchUser() { /* ... */ } },\n  watch: { count() { /* ... */ } }\n}\n","language":"typescript","meta":""},"children":[{"type":"element","tag":"code","props":{"__ignoreMap":""},"children":[{"type":"text","value":"// 选项式：一个功能的代码被分散\nexport default {\n  data() { return { count: 0, user: null } },\n  computed: { doubleCount() { /* ... */ } },\n  methods: { increment() { /* ... */ }, fetchUser() { /* ... */ } },\n  watch: { count() { /* ... */ } }\n}\n"}]}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"组合式 API 让我们可以 "},{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"按功能组织代码"}]},{"type":"text","value":"："}]},{"type":"element","tag":"pre","props":{"className":["language-typescript"],"code":"// 组合式：一个功能的代码集中在一起\nfunction useCounter() {\n  const count = ref(0)\n  const doubleCount = computed(() => count.value * 2)\n  const increment = () => count.value++\n  watch(count, () => console.log('changed'))\n  return { count, doubleCount, increment }\n}\n\nfunction useUser() {\n  const user = ref(null)\n  const fetchUser = async () => { /* ... */ }\n  return { user, fetchUser }\n}\n","language":"typescript","meta":""},"children":[{"type":"element","tag":"code","props":{"__ignoreMap":""},"children":[{"type":"text","value":"// 组合式：一个功能的代码集中在一起\nfunction useCounter() {\n  const count = ref(0)\n  const doubleCount = computed(() => count.value * 2)\n  const increment = () => count.value++\n  watch(count, () => console.log('changed'))\n  return { count, doubleCount, increment }\n}\n\nfunction useUser() {\n  const user = ref(null)\n  const fetchUser = async () => { /* ... */ }\n  return { user, fetchUser }\n}\n"}]}]},{"type":"element","tag":"h2","props":{"id":"核心概念解析"},"children":[{"type":"text","value":"核心概念解析"}]},{"type":"element","tag":"h3","props":{"id":"_1-ref-与-reactive"},"children":[{"type":"text","value":"1. ref 与 reactive"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"ref"}]},{"type":"text","value":" 用于创建基本类型的响应式引用，访问需要通过 "},{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":".value"}]},{"type":"text","value":"："}]},{"type":"element","tag":"pre","props":{"className":["language-typescript"],"code":"const count = ref(0)\nconsole.log(count.value) // 0\ncount.value++\n","language":"typescript","meta":""},"children":[{"type":"element","tag":"code","props":{"__ignoreMap":""},"children":[{"type":"text","value":"const count = ref(0)\nconsole.log(count.value) // 0\ncount.value++\n"}]}]},{"type":"element","tag":"p","props":{},"children":[{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"reactive"}]},{"type":"text","value":" 用于创建对象类型的响应式代理，"},{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"不需要"}]},{"type":"text","value":" "},{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":".value"}]},{"type":"text","value":"："}]},{"type":"element","tag":"pre","props":{"className":["language-typescript"],"code":"const state = reactive({ name: 'Alice', age: 18 })\nconsole.log(state.name) // Alice\nstate.age++\n","language":"typescript","meta":""},"children":[{"type":"element","tag":"code","props":{"__ignoreMap":""},"children":[{"type":"text","value":"const state = reactive({ name: 'Alice', age: 18 })\nconsole.log(state.name) // Alice\nstate.age++\n"}]}]},{"type":"element","tag":"blockquote","props":{},"children":[{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"💡 "},{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"何时用哪个？"}]},{"type":"text","value":" 基本类型（数字、字符串、布尔）用 "},{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"ref"}]},{"type":"text","value":"，复杂对象用 "},{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"reactive"}]},{"type":"text","value":"。不确定时用 "},{"type":"element","tag":"code","props":{"className":[]},"children":[{"type":"text","value":"ref"}]},{"type":"text","value":" 更安全。"}]}]},{"type":"element","tag":