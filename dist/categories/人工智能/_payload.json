[{"data":1,"prerenderedAt":510},["ShallowReactive",2],{"category-人工智能":3},[4],{"_path":5,"_dir":6,"_draft":7,"_partial":7,"_locale":8,"title":9,"description":10,"date":11,"category":12,"tags":13,"body":18,"_type":504,"_id":505,"_source":506,"_file":507,"_stem":508,"_extension":509},"\u002Farticles\u002Fai-prompt-engineering","articles",false,"","从零开始学提示工程：让 AI 成为你的生产力搭档","系统介绍大语言模型提示工程的核心原则与常用技巧，从入门到进阶，教你写出高效、准确、可复用的高质量 Prompt。","2026-07-20","人工智能",[14,15,16,17],"提示工程","AI","GPT","效率",{"type":19,"children":20,"toc":483},"root",[21,29,43,50,62,67,205,211,218,226,236,244,252,258,270,278,284,296,304,310,316,321,329,335,340,348,354,359,367,373,378,386,392,398,406,412,420,426,471],{"type":22,"tag":23,"props":24,"children":26},"element","h1",{"id":25},"从零开始学提示工程",[27],{"type":28,"value":25},"text",{"type":22,"tag":30,"props":31,"children":32},"p",{},[33,35,41],{"type":28,"value":34},"随着 GPT、Claude 等大语言模型（LLM）走入日常开发，",{"type":22,"tag":36,"props":37,"children":38},"strong",{},[39],{"type":28,"value":40},"能否写出好的提示词（Prompt）",{"type":28,"value":42}," 已经成为新的核心技能。好的提示词能让 AI 交付 90 分甚至满分的答案，差的提示词只会得到一堆看似正确实则无用的废话。",{"type":22,"tag":44,"props":45,"children":47},"h2",{"id":46},"一什么是提示工程",[48],{"type":28,"value":49},"一、什么是提示工程？",{"type":22,"tag":30,"props":51,"children":52},{},[53,55,60],{"type":28,"value":54},"提示工程不是玄学，而是 ",{"type":22,"tag":36,"props":56,"children":57},{},[58],{"type":28,"value":59},"用清晰、精确、结构化的自然语言，向 LLM 描述任务",{"type":28,"value":61}," 的过程。LLM 的本质是\"预测下一个最可能的词\"，你给它的上下文越充分、约束越明确，它输出的结果就越贴近你的预期。",{"type":22,"tag":30,"props":63,"children":64},{},[65],{"type":28,"value":66},"一个好的提示词通常包含五要素：",{"type":22,"tag":68,"props":69,"children":70},"table",{},[71,95],{"type":22,"tag":72,"props":73,"children":74},"thead",{},[75],{"type":22,"tag":76,"props":77,"children":78},"tr",{},[79,85,90],{"type":22,"tag":80,"props":81,"children":82},"th",{},[83],{"type":28,"value":84},"要素",{"type":22,"tag":80,"props":86,"children":87},{},[88],{"type":28,"value":89},"作用",{"type":22,"tag":80,"props":91,"children":92},{},[93],{"type":28,"value":94},"示例",{"type":22,"tag":96,"props":97,"children":98},"tbody",{},[99,121,142,163,184],{"type":22,"tag":76,"props":100,"children":101},{},[102,111,116],{"type":22,"tag":103,"props":104,"children":105},"td",{},[106],{"type":22,"tag":36,"props":107,"children":108},{},[109],{"type":28,"value":110},"角色",{"type":22,"tag":103,"props":112,"children":113},{},[114],{"type":28,"value":115},"告诉 AI 它是谁，让它代入专家视角",{"type":22,"tag":103,"props":117,"children":118},{},[119],{"type":28,"value":120},"\"你是一名有 10 年经验的前端架构师\"",{"type":22,"tag":76,"props":122,"children":123},{},[124,132,137],{"type":22,"tag":103,"props":125,"children":126},{},[127],{"type":22,"tag":36,"props":128,"children":129},{},[130],{"type":28,"value":131},"任务",{"type":22,"tag":103,"props":133,"children":134},{},[135],{"type":28,"value":136},"明确告诉它要做什么，不要模糊",{"type":22,"tag":103,"props":138,"children":139},{},[140],{"type":28,"value":141},"\"请重构这段 React 代码\" 而不是 \"帮我看看这个\"",{"type":22,"tag":76,"props":143,"children":144},{},[145,153,158],{"type":22,"tag":103,"props":146,"children":147},{},[148],{"type":22,"tag":36,"props":149,"children":150},{},[151],{"type":28,"value":152},"上下文",{"type":22,"tag":103,"props":154,"children":155},{},[156],{"type":28,"value":157},"提供执行任务所需的背景信息",{"type":22,"tag":103,"props":159,"children":160},{},[161],{"type":28,"value":162},"代码片段、项目背景、用户需求",{"type":22,"tag":76,"props":164,"children":165},{},[166,174,179],{"type":22,"tag":103,"props":167,"children":168},{},[169],{"type":22,"tag":36,"props":170,"children":171},{},[172],{"type":28,"value":173},"约束",{"type":22,"tag":103,"props":175,"children":176},{},[177],{"type":28,"value":178},"明确不能做什么、要遵守什么规则",{"type":22,"tag":103,"props":180,"children":181},{},[182],{"type":28,"value":183},"\"不要引入新依赖\"、\"输出必须是 TypeScript\"",{"type":22,"tag":76,"props":185,"children":186},{},[187,195,200],{"type":22,"tag":103,"props":188,"children":189},{},[190],{"type":22,"tag":36,"props":191,"children":192},{},[193],{"type":28,"value":194},"输出格式",{"type":22,"tag":103,"props":196,"children":197},{},[198],{"type":28,"value":199},"指定回答的结构与形式",{"type":22,"tag":103,"props":201,"children":202},{},[203],{"type":28,"value":204},"\"用表格输出\"、\"JSON 格式、字段如下\"",{"type":22,"tag":44,"props":206,"children":208},{"id":207},"二入门三原则",[209],{"type":28,"value":210},"二、入门三原则",{"type":22,"tag":212,"props":213,"children":215},"h3",{"id":214},"原则-1具体不要模糊",[216],{"type":28,"value":217},"原则 1：具体，不要模糊",{"type":22,"tag":30,"props":219,"children":220},{},[221],{"type":22,"tag":36,"props":222,"children":223},{},[224],{"type":28,"value":225},"❌ 糟糕的提示：",{"type":22,"tag":227,"props":228,"children":230},"pre",{"code":229},"帮我写个网站\n",[231],{"type":22,"tag":232,"props":233,"children":234},"code",{"__ignoreMap":8},[235],{"type":28,"value":229},{"type":22,"tag":30,"props":237,"children":238},{},[239],{"type":22,"tag":36,"props":240,"children":241},{},[242],{"type":28,"value":243},"✅ 好的提示：",{"type":22,"tag":227,"props":245,"children":247},{"code":246},"请用 Next.js 14 + Tailwind CSS 写一个博客首页，要求：\n1. 顶部导航栏包含 logo、菜单、搜索框、主题切换按钮\n2. 首屏 Hero 区展示博客标题、一句 Slogan、CTA 按钮\n3. 下方展示最新 6 篇文章卡片，包含封面、标题、摘要、日期\n4. 使用响应式设计，移动端适配良好\n5. 代码分组件组织，不要都写在一个文件里\n",[248],{"type":22,"tag":232,"props":249,"children":250},{"__ignoreMap":8},[251],{"type":28,"value":246},{"type":22,"tag":212,"props":253,"children":255},{"id":254},"原则-2给示例few-shot-prompting",[256],{"type":28,"value":257},"原则 2：给示例（Few-Shot Prompting）",{"type":22,"tag":30,"props":259,"children":260},{},[261,263,268],{"type":28,"value":262},"当你需要特定风格或格式时，",{"type":22,"tag":36,"props":264,"children":265},{},[266],{"type":28,"value":267},"给 2-3 个示例",{"type":28,"value":269}," 比描述 100 个字更有效：",{"type":22,"tag":227,"props":271,"children":273},{"code":272},"请将以下产品描述重写成更有说服力的营销文案，风格参考示例：\n\n示例 1：\n原文：这双鞋透气。\n重写：夏日炎炎，双脚也能自由呼吸 —— 每一步都像踩在云上 ☁️\n\n示例 2：\n原文：这款充电宝容量大。\n重写：20000mAh 超大能量，陪你从日出看到星河，告别电量焦虑 ⚡\n\n现在请重写：\n原文：这个保温杯保温效果很好。\n",[274],{"type":22,"tag":232,"props":275,"children":276},{"__ignoreMap":8},[277],{"type":28,"value":272},{"type":22,"tag":212,"props":279,"children":281},{"id":280},"原则-3分步思考chain-of-thought",[282],{"type":28,"value":283},"原则 3：分步思考（Chain of Thought）",{"type":22,"tag":30,"props":285,"children":286},{},[287,289,294],{"type":28,"value":288},"对于数学题、逻辑推理、代码分析等复杂问题，加上一句 ",{"type":22,"tag":36,"props":290,"children":291},{},[292],{"type":28,"value":293},"\"请一步步思考并展示你的推理过程\"",{"type":28,"value":295},"，准确率会大幅提升：",{"type":22,"tag":227,"props":297,"children":299},{"code":298},"用户在一个商店买了 3 个苹果和 2 个梨，苹果每个 5 元，梨每个 4 元。\n他又买了 1 袋 18 元的薯片，结账时使用了一张满 50 减 10 的优惠券。\n请问用户最终实际付了多少钱？\n\n请一步步思考，先列出每个步骤，再给出最终答案。\n",[300],{"type":22,"tag":232,"props":301,"children":302},{"__ignoreMap":8},[303],{"type":28,"value":298},{"type":22,"tag":44,"props":305,"children":307},{"id":306},"三进阶技巧",[308],{"type":28,"value":309},"三、进阶技巧",{"type":22,"tag":212,"props":311,"children":313},{"id":312},"_1-结构化输出",[314],{"type":28,"value":315},"1. 结构化输出",{"type":22,"tag":30,"props":317,"children":318},{},[319],{"type":28,"value":320},"不要让 AI 自由发挥格式，明确指定输出结构：",{"type":22,"tag":227,"props":322,"children":324},{"code":323},"请分析以下代码的潜在问题，输出 JSON 数组，每个元素包含：\n- severity: \"error\" | \"warning\" | \"info\"\n- line: 行号\n- issue: 问题描述\n- suggestion: 修改建议\n\n代码如下：\n\n```js\nfunction foo(arr) {\n  for (var i = 0; i \u003C arr.length; i++) {\n    setTimeout(() => console.log(arr[i]), 100);\n  }\n}\n",[325],{"type":22,"tag":232,"props":326,"children":327},{"__ignoreMap":8},[328],{"type":28,"value":323},{"type":22,"tag":212,"props":330,"children":332},{"id":331},"_2-约束幻觉",[333],{"type":28,"value":334},"2. 约束幻觉",{"type":22,"tag":30,"props":336,"children":337},{},[338],{"type":28,"value":339},"LLM 会\"编\"答案，尤其是在它不知道的时候。加上这句约束：",{"type":22,"tag":227,"props":341,"children":343},{"code":342},"如果你不确定答案，请直接说\"我不知道\"，不要编造内容。\n如果有引用，请注明来源出处。\n",[344],{"type":22,"tag":232,"props":345,"children":346},{"__ignoreMap":8},[347],{"type":28,"value":342},{"type":22,"tag":212,"props":349,"children":351},{"id":350},"_3-角色扮演-多视角复核",[352],{"type":28,"value":353},"3. 角色扮演 + 多视角复核",{"type":22,"tag":30,"props":355,"children":356},{},[357],{"type":28,"value":358},"让 AI 同时扮演多个角色，用不同视角审视同一个问题：",{"type":22,"tag":227,"props":360,"children":362},{"code":361},"请扮演三位角色评审我的技术方案：\n1. 资深架构师：从可扩展性、性能、可维护性角度挑刺\n2. 安全工程师：从安全漏洞、数据隐私、权限角度检查\n3. 产品经理：从用户体验、开发成本、上线时间角度评估\n\n方案：我打算用纯前端 localStorage 存用户的登录凭证和订单数据。\n\n请三位分别给出意见，最后给出一个综合建议。\n",[363],{"type":22,"tag":232,"props":364,"children":365},{"__ignoreMap":8},[366],{"type":28,"value":361},{"type":22,"tag":212,"props":368,"children":370},{"id":369},"_4-迭代优化self-correction",[371],{"type":28,"value":372},"4. 迭代优化（Self-Correction）",{"type":22,"tag":30,"props":374,"children":375},{},[376],{"type":28,"value":377},"一次输出不满意？让它自己改自己：",{"type":22,"tag":227,"props":379,"children":381},{"code":380},"请阅读你刚才生成的代码，然后：\n1. 找出其中可能存在的 Bug 和性能问题\n2. 用更简洁、更符合现代 JavaScript 习惯的方式重写\n3. 加上必要的注释和 JSDoc 类型说明\n",[382],{"type":22,"tag":232,"props":383,"children":384},{"__ignoreMap":8},[385],{"type":28,"value":380},{"type":22,"tag":44,"props":387,"children":389},{"id":388},"四模板速查",[390],{"type":28,"value":391},"四、模板速查",{"type":22,"tag":212,"props":393,"children":395},{"id":394},"代码重构模板",[396],{"type":28,"value":397},"📝 代码重构模板",{"type":22,"tag":227,"props":399,"children":401},{"code":400},"角色：你是一名资深 {编程语言} 工程师，推崇简洁、可测试、高性能的代码风格。\n\n任务：请重构以下代码。\n\n上下文：这段代码在 {项目\u002F模块} 中使用，作用是 {简要说明}。\n\n约束：\n- 必须保持原有功能不变，所有外部接口签名兼容\n- 不要引入项目中没有的第三方依赖\n- 要考虑异常处理和边界情况\n- 性能要至少与原版持平或更好\n\n输出要求：\n1. 先列出原始代码的主要问题（3-5 条）\n2. 给出重构后的完整代码\n3. 解释做了哪些改动以及为什么\n\n原代码：\n{粘在这里}\n",[402],{"type":22,"tag":232,"props":403,"children":404},{"__ignoreMap":8},[405],{"type":28,"value":400},{"type":22,"tag":212,"props":407,"children":409},{"id":408},"长文总结模板",[410],{"type":28,"value":411},"📖 长文总结模板",{"type":22,"tag":227,"props":413,"children":415},{"code":414},"请阅读以下文章，输出一份总结报告，包含：\n1. 核心论点（一句话）\n2. 3-5 个关键要点，每个要点配一句话解释\n3. 2-3 个最有启发性的观点或金句\n4. 3 个可以立即落地的行动建议\n5. 一个值得继续深入思考的问题\n\n要求用中文，通俗易懂，避免原文字面翻译和堆砌术语。\n\n文章内容：\n{粘在这里}\n",[416],{"type":22,"tag":232,"props":417,"children":418},{"__ignoreMap":8},[419],{"type":28,"value":414},{"type":22,"tag":44,"props":421,"children":423},{"id":422},"五避坑指南",[424],{"type":28,"value":425},"五、避坑指南",{"type":22,"tag":427,"props":428,"children":429},"ol",{},[430,441,451,461],{"type":22,"tag":431,"props":432,"children":433},"li",{},[434,439],{"type":22,"tag":36,"props":435,"children":436},{},[437],{"type":28,"value":438},"不要一次问太多问题",{"type":28,"value":440},"：一个 prompt 一个任务，拆分成多轮对话效果更好。",{"type":22,"tag":431,"props":442,"children":443},{},[444,449],{"type":22,"tag":36,"props":445,"children":446},{},[447],{"type":28,"value":448},"不要把重要信息藏在长文本末尾",{"type":28,"value":450},"：关键约束放在开头或最后单独强调。",{"type":22,"tag":431,"props":452,"children":453},{},[454,459],{"type":22,"tag":36,"props":455,"children":456},{},[457],{"type":28,"value":458},"不要迷信一次成功",{"type":28,"value":460},"：优秀的提示词是迭代出来的，先写一版，看输出再调整。",{"type":22,"tag":431,"props":462,"children":463},{},[464,469],{"type":22,"tag":36,"props":465,"children":466},{},[467],{"type":28,"value":468},"不要忽略系统提示词（System Prompt）",{"type":28,"value":470},"：System 级别的角色设定比用户消息权重更高。",{"type":22,"tag":30,"props":472,"children":473},{},[474,476,481],{"type":28,"value":475},"提示工程的本质是 ",{"type":22,"tag":36,"props":477,"children":478},{},[479],{"type":28,"value":480},"\"把脑子里的隐性知识显性化\"",{"type":28,"value":482}," —— 你越清楚自己想要什么，越能清晰地描述出来，AI 就越能成为你的得力搭档。从今天开始，把每一次和 AI 的对话当成练习，你会发现这个技能的回报超乎想象 ✨",{"title":8,"searchDepth":484,"depth":484,"links":485},2,[486,487,493,499,503],{"id":46,"depth":484,"text":49},{"id":207,"depth":484,"text":210,"children":488},[489,491,492],{"id":214,"depth":490,"text":217},3,{"id":254,"depth":490,"text":257},{"id":280,"depth":490,"text":283},{"id":306,"depth":484,"text":309,"children":494},[495,496,497,498],{"id":312,"depth":490,"text":315},{"id":331,"depth":490,"text":334},{"id":350,"depth":490,"text":353},{"id":369,"depth":490,"text":372},{"id":388,"depth":484,"text":391,"children":500},[501,502],{"id":394,"depth":490,"text":397},{"id":408,"depth":490,"text":411},{"id":422,"depth":484,"text":425},"markdown","content:articles:ai-prompt-engineering.md","content","articles\u002Fai-prompt-engineering.md","articles\u002Fai-prompt-engineering","md",1785598913245]